				$Columns[] = "`kode_barang` = " . (trim((string)$DataB['kode_barang'])!='' ? "'" . escape_string($DataB['kode_barang']) . "'" : "NULL");
				$Columns[] = "`qty` = " . (trim((string)$DataB['qty'])!='' ? "'" . escape_string($DataB['qty']) . "'" : "NULL");
				$Columns[] = "`satuan` = " . (trim((string)$DataB['satuan'])!='' ? "'" . escape_string($DataB['satuan']) . "'" : "NULL");
				$Columns[] = "`operasi` = " . (trim((string)$DataB['operasi'])!='' ? "'" . escape_string($DataB['operasi']) . "'" : "NULL");
				$Columns[] = "`kelipatan` = " . ((preg_match('/^(ya|true|1)$/i', $DataB['kelipatan'])) ? "TRUE" : "FALSE");

				$SqlB2 = "SELECT * from inv_promo_barang where kode_promo_barang = '" . escape_string($DataB['kode_promo_barang']) . "' ";
