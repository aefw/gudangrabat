				$Sql2 = "INSERT INTO inv_promo SET " . implode(', ', $Columns);
				$this -> db -> query($Sql2);
				echo "[inserted]";
			} else {
				$_Data = $Query2->fetch_array();
				$id = $_Data['id_inv_promo'];
				$Sql2 = "UPDATE inv_promo SET " . implode(', ', $Columns) . " WHERE id_inv_promo = '" . escape_string($id) . "' ";
				$this -> db -> query($Sql2);
				echo "[updated]";
			}

			// mst_promo_barang → inv_promo_barang
			$Sql = "SELECT * from mst_promo_barang where kode_promo = '" . escape_string($Data['kode_promo']) . "' order by kode_promo_barang ";
