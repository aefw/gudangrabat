			$Columns[] = "`kelipatan` = " . ((preg_match('/^(ya|true|1)$/i', $Data['kelipatan'])) ? "TRUE" : "FALSE");
			$Columns[] = "`jenis_hadiah` = " . (trim((string)$Data['jenis_hadiah'])!='' ? "'" . escape_string($Data['jenis_hadiah']) . "'" : "NULL");
			$Columns[] = "`diskon` = " . (trim((string)$Data['diskon'])!='' ? "'" . escape_string($Data['diskon']) . "'" : "NULL");
			$Columns[] = "`khusus_member` = " . ((preg_match('/^(ya|true|1)$/i', $Data['khusus_member'])) ? "TRUE" : "FALSE");
			$Columns[] = "`max_penjualan` = " . (trim((string)$Data['max_penjualan'])!='' ? "'" . escape_string($Data['max_penjualan']) . "'" : "NULL");

			$Sql2 = "SELECT * from inv_promo where kode_promo = '" . escape_string($Data['kode_promo']) . "' ";
