	function getAccAkun3() {
		// BEGIN Acc Akun3
		$Sql = "SELECT * from acc_akun3 where kode_akun2='11' order by kode_akun3 ";
		$Query = $this -> dbpgMRO -> query($Sql);
		$Datas = $Query->result_array();
		foreach($Datas as $Data) {
			echo "\n{$Data['kode_akun3']} ";
			$Columns = array();
			$Columns[] = "`kode_acc_3` = " . ((trim($Data['kode_akun3'])!='') ? "'" . escape_string($Data['kode_akun3']) . "'" : "NULL");
			$Columns[] = "`nama_acc_3` = " . ((trim($Data['nama_akun3'])!='') ? "'" . escape_string($Data['nama_akun3']) . "'" : "NULL");
			$Columns[] = "`id_keu_acc_2` = '11' ";
			$Columns[] = "`rumus` = " . ((trim($Data['rumus'])!='') ? (($Data['rumus']=='D-K') ? "'DC'" : "'CD'") : "NULL");
			$Columns[] = "`positive` = " . ((trim($Data['posisi'])!='') ? (($Data['posisi']=='Plus') ? "TRUE" : "FALSE") : "NULL");
			$Sql = "SELECT * from keu_acc_3 where kode_acc_3 = '" . escape_string($Data['kode_akun3']) . "' ";
			$Query = $this -> db -> query($Sql);
			if( $Query->num_rows() == 0 ) {
				$id = $this -> db -> next_autoincrement('{prefix}keu_acc_3');
				//$Columns[] = "id_keu_acc_2 = '11'";
				$Columns[] = "`id_keu_acc_3` = '" . escape_string($id) . "'";
				$Sql = "INSERT INTO keu_acc_3 set " . implode(', ', $Columns);
				$Query = $this -> db -> query($Sql);
			} else {
				$_Data = $Query->fetch_array();
				$id = $_Data['id_keu_acc_3'];
				$Sql = "UPDATE keu_acc_3 set " . implode(', ', $Columns) . " where id_keu_acc_3 = '" . escape_string($id) . "' ";
				$Query = $this -> db -> query($Sql);
			}
			echo "[ok]\n";
		}
		// END Acc Akun3
	}

	function getPegawai() {
		// BEGIN PEGAWAI
		$Sql = "SELECT * from mst_karyawan order by kode_karyawan ";
		$Query = $this -> dbpgMRO -> query($Sql);
		$Datas = $Query->result_array();
		foreach($Datas as $Data) {
			echo "\n{$Data['kode_karyawan']} ";
			$Columns = array();
			$Columns[] = "`kode_pegawai` = " . ((trim($Data['kode_karyawan'])!='') ? "'" . escape_string($Data['kode_karyawan']) . "'" : "NULL");
			$Columns[] = "`nip` = " . ((trim($Data['barcode'])!='') ? "'" . escape_string($Data['barcode']) . "'" : "NULL");
			$Columns[] = "`pegawai_nama` = " . ((trim($Data['nama_karyawan'])!='') ? "'" . escape_string($Data['nama_karyawan']) . "'" : "NULL");
			$Sql = "SELECT * from peg_pegawai where kode_pegawai = '" . escape_string($Data['kode_karyawan']) . "' ";
			$Query = $this -> db -> query($Sql);
			if( $Query->num_rows() == 0 ) {
				$id = $this -> db -> next_autoincrement('{prefix}peg_pegawai');
				$Columns[] = "`created` = now()";
				$Columns[] = "`id_peg_pegawai` = '" . escape_string($id) . "'";
				$Sql = "INSERT INTO peg_pegawai set " . implode(', ', $Columns);
				$Query = $this -> db -> query($Sql);
			} else {
				$_Data = $Query->fetch_array();
				$id = $_Data['id_peg_pegawai'];
				$Sql = "UPDATE peg_pegawai set " . implode(', ', $Columns) . " where id_peg_pegawai = '" . escape_string($id) . "' ";
				$Query = $this -> db -> query($Sql);
			}
			echo "[ok]\n";
		}
		// END PEGAWAI
	}

	function getGudang() {
		// BEGIN GUDANG
		$Sql = "SELECT * from mst_gudang order by kode_gudang ";
		$Query = $this -> dbpgMRO -> query($Sql);
		$Datas = $Query->result_array();
		foreach($Datas as $Data) {
			echo "\n{$Data['kode_gudang']} ";
			$Columns = array();
			foreach($Data as $key => $value) {
				if( trim((string) $value) == '' ) $value = null;
				$value = trim((string) $value);
				$Columns[] = "`" . $key . "` = " . ((trim((string) $value)!='') ? "'" . escape_string($value) . "'" : "NULL");
			}
			$Sql = "SELECT * from mst_gudang where kode_gudang = '" . escape_string($Data['kode_gudang']) . "' ";
			$Query = $this -> db -> query($Sql);
			if( $Query->num_rows() == 0 ) {
				$id = $this -> db -> next_autoincrement('{prefix}mst_gudang');
				$Columns[] = "`id_mst_gudang` = '" . escape_string($id) . "'";
				$Sql = "INSERT INTO mst_gudang set " . implode(', ', $Columns);
				$Query = $this -> db -> query($Sql);
			} else {
				$_Data = $Query->fetch_array();
				$id = $_Data['id_mst_gudang'];
				$Sql = "UPDATE mst_gudang set " . implode(', ', $Columns) . " where id_mst_gudang = '" . escape_string($id) . "' ";
				$Query = $this -> db -> query($Sql);
			}
			echo "[ok]\n";
		}
		// END GUDANG
	}

	function getKategori() {
		// BEGIN KATEGORI
		$Sql = "SELECT * from inv_kategori order by kode_kategori ";
		$Query = $this -> dbpgMRO -> query($Sql);
		$Datas = $Query->result_array();
		foreach($Datas as $Data) {
			echo "\n{$Data['kode_kategori']} ";
			$Columns = array();
			foreach($Data as $key => $value) {
				if( trim((string) $value) == '' ) $value = null;
				$value = trim((string) $value);
				$Columns[] = "`" . $key . "` = " . ((trim((string) $value)!='') ? "'" . escape_string($value) . "'" : "NULL");
			}
			if( ! isset($Data['nama_kategori']) ) {
				$value = preg_replace('/('.($Data['kode_kategori']).')[\s+]/', '', $Data['keterangan']);
				$Columns[] = "`nama_kategori` = " . ((trim((string) $value)!='') ? "'" . escape_string($value) . "'" : "NULL");
			}
			$Sql = "SELECT * from inv_kategori where kode_kategori = '" . escape_string($Data['kode_kategori']) . "' ";
			$Query = $this -> db -> query($Sql);
			if( $Query->num_rows() == 0 ) {
				$id = $this -> db -> next_autoincrement('{prefix}inv_kategori');
				$Columns[] = "`id_inv_kategori` = '" . escape_string($id) . "'";
				$Sql = "INSERT INTO inv_kategori set " . implode(', ', $Columns);
				$Query = $this -> db -> query($Sql);
			} else {
				$_Data = $Query->fetch_array();
				$id = $_Data['id_inv_kategori'];
				$Sql = "UPDATE inv_kategori set " . implode(', ', $Columns) . " where id_inv_kategori = '" . escape_string($id) . "' ";
				$Query = $this -> db -> query($Sql);
			}
			echo "[ok]\n";
		}
		// END KATEGORI
	}

	function getBarang() {
		// BEGIN BARANG
		$Sql = "SELECT * from inv_barang order by kode_barang ";
		$Query = $this -> dbpgMRO -> query($Sql);
		$Datas = $Query->result_array();
		foreach($Datas as $Data) {
			echo "\n{$Data['kode_barang']} ";
			$Columns = array();
			foreach($Data as $key => $value) {
				if( trim((string) $value) == '' ) $value = null;
				if( preg_match('/^(harga_jual)$/i', $key) ) {
					unset($Data[$key]);
					$key = 'harga_jual_1';
					$value = $value ?? 0;
					$Data[$key] = $value;
				}
				if( preg_match('/^(harga_jual_toko)$/i', $key) ) {
					unset($Data[$key]);
					$key = 'harga_jual_2';
					$value = $value ?? $Data['harga_jual_1'] ?? $Data['harga_jual'] ?? 0;
					$Data[$key] = $value;
				}
				if( preg_match('/^(satuan)$/i', $key) ) {
					$value = $value ?? 'pcs';
					$Data[$key] = $value;
				}
				if( preg_match('/^(nama_barang)$/i', $key) ) {
					if( trim((string) $value) == '' ) {
						echo "[skipped] nama_barang is empty\n";
						continue 2; // skip data if nama_barang is empty // continue 2, merupakan continue untuk nested diatasnya, kalau hanya continue maka hanya untuk loop saat ini
					}
				}
				if( preg_match('/^(aktif_mro)$/i', $key) ) {
					$key = 'visible';
					$value = ( trim((string) $Data['aktif_mro'])=='Ya' ) ? 1 : 0;
					$Data[$key] = $value;
				}
				if( preg_match('/^(max_penjualan_member)$/i', $key) ) continue; // skip colomn
				$value = trim((string) $value);
				if( $key == 'min_order_cust' ) { $value = (int) $value; $value = ($value > 0) ? $value : 1; }
				if( preg_match('/^(harga_jual_[\d])$/i', $key) ) $value = ceil($value); // HARGA JUAL PEMBULATAN NAIK
				$Columns[] = "`" . $key . "` = " . ((trim((string) $value)!='') ? "'" . escape_string($value) . "'" : "NULL");
			}
			if( ! isset($Data['tanggal_input']) ) {
				$Columns[] = "`tanggal_input` = now()";
				$Columns[] = "`jam_input` = now()";
			}
			if( ! isset($Data['harga_jual_2']) ) {
				$Data['harga_jual_2'] = $Data['harga_jual_1'] ?? 0;
				$value = $Data['harga_jual_2'];
				$Columns[] = "`harga_jual_2` = " . ((trim((string) $value)!='') ? "'" . escape_string($value) . "'" : "NULL");
			}
			if( ! isset($Data['harga_jual_3']) ) {
				$Data['harga_jual_3'] = $Data['harga_jual_2'] ?? 0;
				$value = $Data['harga_jual_3'];
				$Columns[] = "`harga_jual_3` = " . ((trim((string) $value)!='') ? "'" . escape_string($value) . "'" : "NULL");
			}
			$Sql = "SELECT * from inv_barang where kode_barang = '" . escape_string($Data['kode_barang']) . "' ";
			$Query = $this -> db -> query($Sql);
			if( $Query->num_rows() == 0 ) {
				$id = $this -> db -> next_autoincrement('{prefix}inv_barang');
				$Columns[] = "`id_inv_barang` = '" . escape_string($id) . "'";
				$Columns[] = "`created` = now()";
				$Sql = "INSERT INTO inv_barang set " . implode(', ', $Columns);
				$Query = $this -> db -> query($Sql);
			} else {
				$_Data = $Query->fetch_array();
				$id = $_Data['id_inv_barang'];
				$Sql = "UPDATE inv_barang set " . implode(', ', $Columns) . " where id_inv_barang = '" . escape_string($id) . "' ";
				$Query = $this -> db -> query($Sql);
			}

			$satuan_grosir = $Data['satuan'];
			$harga_jual_1 = ceil($Data['harga_jual_1']); // HARGA JUAL PEMBULATAN NAIK
			$harga_jual_2 = ceil($Data['harga_jual_2']); // HARGA JUAL PEMBULATAN NAIK
			$harga_jual_3 = ceil($Data['harga_jual_3']); // HARGA JUAL PEMBULATAN NAIK
			$id_inv_barang = $id;
			$Columns = array();
			$Sql = "SELECT * from inv_barang_harga where id_inv_barang='" . escape_string($id_inv_barang) . "' and min_qty='1' ";
			$Query = $this -> db -> query($Sql);
			if( $Query->num_rows() == 0 ) {
				$id = $this -> db -> next_autoincrement('{prefix}inv_barang_harga');
				$Columns[] = "`id_inv_barang_harga` = '" . escape_string($id) . "'";
				$Columns[] = "`id_inv_barang` = '" . escape_string($id_inv_barang) . "'";
				$Columns[] = "`min_qty` = '1'";
				$Columns[] = "`satuan_grosir` = '" . escape_string($satuan_grosir) . "'";
				$Columns[] = "`harga_jual_1` = '" . escape_string($harga_jual_1) . "'";
				$Columns[] = "`harga_jual_2` = '" . escape_string($harga_jual_2) . "'";
				$Columns[] = "`harga_jual_3` = '" . escape_string($harga_jual_3) . "'";
				$Columns[] = "`created` = now()";
				$Sql = "INSERT INTO inv_barang_harga set " . implode(', ', $Columns);
				$Query = $this -> db -> query($Sql);
			} else {
				$_Data = $Query->fetch_array();
				$id = $_Data['id_inv_barang'];
				//$Columns[] = "`id_inv_barang` = '" . escape_string($id_inv_barang) . "'";
				//$Columns[] = "`min_qty` = '1'";
				$Columns[] = "`satuan_grosir` = '" . escape_string($satuan_grosir) . "'";
				$Columns[] = "`harga_jual_1` = '" . escape_string($harga_jual_1) . "'";
				$Columns[] = "`harga_jual_2` = '" . escape_string($harga_jual_2) . "'";
				$Columns[] = "`harga_jual_3` = '" . escape_string($harga_jual_3) . "'";
				$Sql = "UPDATE inv_barang_harga set " . implode(', ', $Columns) . " where id_inv_barang_harga = '" . escape_string($id) . "' and min_qty='1' ";
				$Query = $this -> db -> query($Sql);
			}
			echo "[ok]\n";
		}
		$Sql = "UPDATE inv_barang set min_order_cust = 1 where min_order_cust <= 0 or min_order_cust is null ";
		$Query = $this -> db -> query($Sql);
		// END BARANG
	}
	function getStokDC() {
		// BEGIN STOK DC
		$Sql = "SELECT id_inv_barang,barcode from inv_barang where `visible`=true order by id_inv_barang ";
		$Query = $this -> db -> query($Sql);
		$Datas = $Query->result_array();
		foreach($Datas as $Data) {
			$Sql = "SELECT stok_gudang_1 from inv_barang where barcode = '" . escape_string($Data['barcode']) . "' ";
			$Query = $this -> dbpgDC -> query($Sql);
			$stok_gudang_1 = $Query->fetch_array();

			if( ! $stok_gudang_1 ) continue;

			$stok_gudang_1 = $stok_gudang_1['stok_gudang_1'];
			if( $stok_gudang_1 == '' ) {
				$stok_gudang_1 = 0;
			}
			if( $stok_gudang_1 < 0 ) {
				$stok_gudang_1 = 0;
			}
			echo "\n{$Data['barcode']} => {$stok_gudang_1} \n";

			$Sql = "UPDATE inv_barang set stok_gudang_1 = '" . escape_string($stok_gudang_1) . "' where id_inv_barang = '" . escape_string($Data['id_inv_barang']) . "' ";
			$Query = $this -> db -> query($Sql);
		}
		// END STOK DC
	}
	function getPaket() {
		// BEGIN PAKET - Sync inv_paket from PostgreSQL to inv_barang_harga
		$Sql = "WITH ranked AS (
    SELECT
        kode_paket,
        kode_barang,
        qty_minimum,
        harga,
        khusus_member,
        satuan_paket,
        tanggal_awal,
        tanggal_akhir,
        ROW_NUMBER() OVER (
            PARTITION BY kode_barang, qty_minimum, khusus_member
            ORDER BY tanggal_akhir ASC
        ) AS rn
    FROM inv_paket
    WHERE jenis = 'Ubah Harga'
      AND CURRENT_DATE BETWEEN tanggal_awal AND tanggal_akhir
),

-- ambil harga terpilih (per member / non-member)
selected AS (
    SELECT *
    FROM ranked
    WHERE rn = 1
),

-- ambil tanggal paling cepat berakhir (global)
tanggal_terdekat AS (
    SELECT
        kode_barang,
        qty_minimum,
        MIN(tanggal_awal) AS tanggal_awal,
        MIN(tanggal_akhir) AS tanggal_akhir
    FROM inv_paket
    WHERE jenis = 'Ubah Harga'
      AND CURRENT_DATE BETWEEN tanggal_awal AND tanggal_akhir
    GROUP BY kode_barang, qty_minimum
),

-- gabung kode paket
paket_agg AS (
    SELECT
        kode_barang,
        qty_minimum,
        STRING_AGG(kode_paket, ',') AS kolom_pakets
    FROM inv_paket
    WHERE jenis = 'Ubah Harga'
      AND CURRENT_DATE BETWEEN tanggal_awal AND tanggal_akhir
    GROUP BY kode_barang, qty_minimum
)

SELECT
    s.kode_barang,
    s.qty_minimum,

    -- harga
    MAX(CASE
        WHEN s.khusus_member = 'Tidak' THEN s.harga
    END) AS harga_jual_1,

    MAX(CASE
        WHEN s.khusus_member = 'Ya' THEN s.harga
    END) AS harga_jual_2,

    -- satuan paket (ambil salah satu karena untuk qty sama, satuan_paket pasti sama)
    -- jika NULL, default ke 'Paket'
    COALESCE(MAX(s.satuan_paket), 'Paket') AS satuan_paket,

    -- tanggal global (paling cepat berakhir)
    t.tanggal_awal,
    t.tanggal_akhir,

    p.kolom_pakets

FROM selected s
JOIN tanggal_terdekat t USING (kode_barang, qty_minimum)
JOIN paket_agg p USING (kode_barang, qty_minimum)

GROUP BY
    s.kode_barang,
    s.qty_minimum,
    t.tanggal_awal,
    t.tanggal_akhir,
    p.kolom_pakets

ORDER BY
    s.kode_barang,
    s.qty_minimum
";
		$Query = $this -> dbpgMRO -> query($Sql);
		$Datas = $Query->result_array();
		foreach($Datas as $Data) {
			echo "\nkode_barang: {$Data['kode_barang']} ";

			$min_qty = (float)($Data['qty_minimum'] ?? 1);
			if( $min_qty <= 1 ) continue;

			// Get id_inv_barang from MariaDB
			//$Sql = "SELECT id_inv_barang FROM inv_barang WHERE kode_barang = '" . escape_string($Data['kode_barang']) . "' ";
			$Sql = "SELECT b.kode_barang, b.id_inv_barang, b.harga_jual_1, b.harga_jual_2, b.harga_jual_3, b.satuan
				FROM inv_barang b 
				LEFT OUTER JOIN inv_barang_harga h USING(id_inv_barang)
				WHERE b.kode_barang = '" . escape_string($Data['kode_barang']) . "'
				AND h.min_qty = 1
				";
			$Query = $this -> db -> query($Sql);
			if( $Query->num_rows() == 0 ) {
				echo "[skipped - no base barang]\n";
				continue;
			}
			$Barang = $Query->fetch_array();
			$id_inv_barang = $Barang['id_inv_barang'];

			$Sql = "UPDATE inv_barang_harga set `active` = FALSE where `id_inv_barang` = '" . escape_string($id_inv_barang) . "' and `min_qty` >= 2 ";
			$Query = $this -> db -> query($Sql); // Disabled karena mengakibatkan min_qty yang masih aktif tetapi beda min_aty yg ada
		}
		print_r("ok\nok\nok");
		foreach($Datas as $Data) {
			if( $Data['qty_minimum'] >= 2 ) print_r($Data);
			echo "\nkode_barang: {$Data['kode_barang']} ";

			$min_qty = (float)($Data['qty_minimum'] ?? 1);
			if( $min_qty <= 1 ) continue;

			// Get id_inv_barang from MariaDB
			//$Sql = "SELECT id_inv_barang FROM inv_barang WHERE kode_barang = '" . escape_string($Data['kode_barang']) . "' ";
			$Sql = "SELECT b.kode_barang, b.id_inv_barang, b.harga_jual_1, b.harga_jual_2, b.harga_jual_3, b.satuan
				FROM inv_barang b 
				LEFT OUTER JOIN inv_barang_harga h USING(id_inv_barang)
				WHERE b.kode_barang = '" . escape_string($Data['kode_barang']) . "'
				AND h.min_qty = 1
				";
			$Query = $this -> db -> query($Sql);
			if( $Query->num_rows() == 0 ) {
				echo "[skipped - no base barang]\n";
				continue;
			}
			$Barang = $Query->fetch_array();
			$id_inv_barang = $Barang['id_inv_barang'];

			//$Sql = "UPDATE inv_barang_harga set `active` = FALSE where `id_inv_barang` = '" . escape_string($id_inv_barang) . "' and `min_qty` >= 2 ";
			//$Query = $this -> db -> query($Sql); // Disabled karena mengakibatkan min_qty yang masih aktif tetapi beda min_aty yg ada

			if( trim((string) $Data['harga_jual_1']) == '' ) {
				$Data['harga_jual_1'] = $Barang['harga_jual_1'];
			}
			if( trim((string) $Data['harga_jual_2']) == '' ) {
				$Data['harga_jual_2'] = $Barang['harga_jual_2'];
			}
				$Data['harga_jual_3'] = $Barang['harga_jual_3'];

			$Columns = array();
			//$id_inv_barang_harga = trim($Data['kode_paket']);
			$min_qty = (float)($Data['qty_minimum'] ?? 1);
			$harga_jual_1 = ceil((float)($Data['harga_jual_1'] ?? '')); // ceil like getBarang
			$harga_jual_2 = ceil((float)($Data['harga_jual_2'] ?? $harga_jual_1)); // ceil like getBarang
			$harga_jual_3 = ceil((float)($Data['harga_jual_2'] ?? $harga_jual_1)); // ceil like getBarang, default sama dengan harga_jual_2

			$active = true; // default active true, karena data paket yang diambil sudah difilter berdasarkan tanggal aktifnya di SQL
			if( $harga_jual_1 <= 0 && $harga_jual_2 <= 0 && $harga_jual_3 <= 0 ) {
				$active = false; // jika semua harga jual <= 0, maka set active false, karena tidak masuk akal jika harga jual <= 0, kemungkinan data paket hanya untuk diskon tanpa harga jual, atau harga jual belum diisi, sehingga tidak perlu diaktifkan
			}

			//$Columns[] = "`id_inv_barang_harga` = '" . escape_string($id_inv_barang_harga) . "'";
			$Columns[] = "`id_inv_barang` = '" . escape_string($id_inv_barang) . "'";
			$Columns[] = "`min_qty` = '" . escape_string($min_qty) . "'";
			$Columns[] = "`harga_jual_1` = '" . escape_string($harga_jual_1 * $min_qty) . "'";
			$Columns[] = "`harga_jual_2` = '" . escape_string($harga_jual_2 * $min_qty) . "'"; // same as 1 unless specified
			$Columns[] = "`harga_jual_3` = '" . escape_string($harga_jual_3 * $min_qty) . "'"; // same as 1 unless specified
			$Columns[] = "`begin_dt` = '" . escape_string($Data['tanggal_awal'] ?? date('Y-m-d')) . " 00:00:00'";
			$Columns[] = "`end_dt` = '" . escape_string($Data['tanggal_akhir'] ?? date('Y-m-d')) . " 23:59:59'";
			$Columns[] = "`active` = " . ($active ? "TRUE" : "FALSE");
			$Columns[] = "`satuan_grosir` = '" . escape_string((!empty($Data['satuan_paket']) && trim((string) $Data['satuan_paket'])!='') ? $Data['satuan_paket'] : 'Paket') . "' -- 'Paket'";
			$Columns[] = "`created` = NOW()";
			
			// Check if exists
			$Sql = "SELECT * FROM inv_barang_harga WHERE `id_inv_barang` = '" . escape_string($id_inv_barang) . "' AND `min_qty` = '" . escape_string($min_qty) . "' ";
			$Query = $this -> db -> query($Sql);
			if( $Query->num_rows() == 0 ) {
				$Sql = "INSERT INTO inv_barang_harga SET " . implode(', ', $Columns);
				$this -> db -> query($Sql);
				echo "[inserted]\n";
			} else {
				$Sql = "UPDATE inv_barang_harga SET " . implode(', ', $Columns) . " WHERE `id_inv_barang` = '" . escape_string($id_inv_barang) . "' AND `min_qty` = '" . escape_string($min_qty) . "' ";
				$this -> db -> query($Sql);
				echo "[updated]\n";
			}
		}
		// END PAKET
	}
	function getPromo() {
		// BEGIN PROMO
		$Sql = "SELECT * from mst_promo order by kode_promo ";
		$Query = $this -> dbpgMRO -> query($Sql);
		$Datas = $Query->result_array();
		foreach($Datas as $Data) {
			echo "\n[PROMO] {$Data['kode_promo']} ";
			$Data['kelipatan'] = strtolower(trim((string)$Data['kelipatan']));
			$Data['khusus_member'] = strtolower(trim((string)$Data['khusus_member']));
			$Columns = array();
			$Columns[] = "`kode_promo` = '" . escape_string($Data['kode_promo']) . "'";
			$Columns[] = "`tanggal_awal` = " . (trim((string)$Data['tanggal_awal'])!='' ? "'" . escape_string($Data['tanggal_awal']) . "'" : "NULL");
			$Columns[] = "`tanggal_akhir` = " . (trim((string)$Data['tanggal_akhir'])!='' ? "'" . escape_string($Data['tanggal_akhir']) . "'" : "NULL");
			$Columns[] = "`keterangan` = " . (trim((string)$Data['keterangan'])!='' ? "'" . escape_string($Data['keterangan']) . "'" : "''");
			$Columns[] = "`minimum_belanja` = " . (trim((string)$Data['minimum_belanja'])!='' ? "'" . escape_string($Data['minimum_belanja']) . "'" : "NULL");
			$Columns[] = "`jenis_pelanggan` = " . (trim((string)$Data['jenis_pelanggan'])!='' ? "'" . escape_string($Data['jenis_pelanggan']) . "'" : "NULL");
			$Columns[] = "`jenis_barang` = " . (trim((string)$Data['jenis_barang'])!='' ? "'" . escape_string($Data['jenis_barang']) . "'" : "NULL");
