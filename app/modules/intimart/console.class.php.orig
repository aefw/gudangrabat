	echo "x = $x"
	for cmd in "pushToko" "diskonImplemented" "invoice_generate" "invoice_syn_necto"; do
		echo "php8.1 \"$SELF_DIR/index.php\" \"intimart/console/$cmd\" -host=$DOMAIN";
		php8.1 "$SELF_DIR/index.php" "intimart/console/$cmd" -host=$DOMAIN > "/tmp/$cmd.log" 2> "/tmp/$cmd-error.log";
		if [ $cmd == "invoice_generate" ]; then
			mv "/tmp/$cmd.log" "/tmp/$cmd.command";
			echo "/tmp/$cmd.command";
			chmod +x "/tmp/$cmd.command";
			"/tmp/$cmd.command" > "/tmp/$cmd.log" 2> "/tmp/$cmd-error.log";
		fi
	done
	sleep $(( (60 / x) - 3 )); # sleep for a while, adjust as needed
	((x--))
done
EOF
