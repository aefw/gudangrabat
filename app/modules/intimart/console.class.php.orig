					$SqlB2 = "INSERT INTO inv_promo_barang SET " . implode(', ', $Columns);
					$this -> db -> query($SqlB2);
					echo "[inserted]";
				} else {
					$_DataB = $QueryB2->fetch_array();
					$idB = $_DataB['id_inv_promo_barang'];
					$SqlB2 = "UPDATE inv_promo_barang SET " . implode(', ', $Columns) . " WHERE id_inv_promo_barang = '" . escape_string($idB) . "' ";
					$this -> db -> query($SqlB2);
					echo "[updated]";
				}
			}

			// mst_promo_hadiah → inv_promo_hadiah
			$Sql = "SELECT * from mst_promo_hadiah where kode_promo = '" . escape_string($Data['kode_promo']) . "' order by kode_promo_hadiah ";
			$Query = $this -> dbpgMRO -> query($Sql);
			$Datas = $Query->result_array();
			foreach($Datas as $DataH) {
				echo "\n  [HADIAH] {$DataH['kode_promo_hadiah']} ";
				$Columns = array();
				$Columns[] = "`kode_promo_hadiah` = '" . escape_string($DataH['kode_promo_hadiah']) . "'";
				$Columns[] = "`kode_promo` = '" . escape_string($DataH['kode_promo']) . "'";
				$Columns[] = "`kode_barang` = " . (trim((string)$DataH['kode_barang'])!='' ? "'" . escape_string($DataH['kode_barang']) . "'" : "NULL");
				$Columns[] = "`harga_khusus` = " . (trim((string)$DataH['harga_khusus'])!='' ? "'" . escape_string($DataH['harga_khusus']) . "'" : "NULL");
				$Columns[] = "`jumlah` = " . (trim((string)$DataH['jumlah'])!='' ? "'" . escape_string($DataH['jumlah']) . "'" : "NULL");
				$Columns[] = "`jenis` = " . (trim((string)$DataH['jenis'])!='' ? "'" . escape_string($DataH['jenis']) . "'" : "NULL");
				$Columns[] = "`satuan` = " . (trim((string)$DataH['satuan'])!='' ? "'" . escape_string($DataH['satuan']) . "'" : "NULL");
				$Columns[] = "`mode` = " . (trim((string)$DataH['mode'])!='' ? "'" . escape_string($DataH['mode']) . "'" : "NULL");

				$SqlH2 = "SELECT * from inv_promo_hadiah where kode_promo_hadiah = '" . escape_string($DataH['kode_promo_hadiah']) . "' ";
				$QueryH2 = $this -> db -> query($SqlH2);
				if( $QueryH2->num_rows() == 0 ) {
					$idH = $this -> db -> next_autoincrement('{prefix}inv_promo_hadiah');
					$Columns[] = "`id_inv_promo_hadiah` = '" . escape_string($idH) . "'";
					$Columns[] = "`created` = NOW()";
					$SqlH2 = "INSERT INTO inv_promo_hadiah SET " . implode(', ', $Columns);
					$this -> db -> query($SqlH2);
					echo "[inserted]";
				} else {
					$_DataH = $QueryH2->fetch_array();
					$idH = $_DataH['id_inv_promo_hadiah'];
					$SqlH2 = "UPDATE inv_promo_hadiah SET " . implode(', ', $Columns) . " WHERE id_inv_promo_hadiah = '" . escape_string($idH) . "' ";
					$this -> db -> query($SqlH2);
					echo "[updated]";
				}
			}
			echo "\n";
		}
		// END PROMO
	}

	function getToko() {
		// BEGIN TOKO
		$Sql = "SELECT * from mst_pelanggan order by kode_pelanggan ";
		$Query = $this -> dbpgMRO -> query($Sql);
		$Datas = $Query->result_array();
		foreach($Datas as $Data) {
			echo "\n{$Data['kode_pelanggan']} ";
			$Columns = array();
			foreach($Data as $key => $value) {
				if( trim((string) $value) == '' ) $value = null;
				if( preg_match('/(_pelanggan)$/i', $key) ) {
					unset($Data[$key]);
					$key = str_replace('_pelanggan', '_toko', $key);
					$Data[$key] = $value;
				}
				if( preg_match('/^(akun_piutang)$/i', $key) ) {
					unset($Data[$key]);
					$key = 'kode_pelanggan_acc';
					$Data[$key] = $value;
				}
				if( preg_match('/^(jenis)$/i', $key) ) {
					$Data['kode_harga'] = 1;
					if( strtolower(trim((string) $value)) == strtolower('Reguler') ) $Data['kode_harga'] = 1;
					if( strtolower(trim((string) $value)) == strtolower('Toko') ) $Data['kode_harga'] = 2;
					$Columns[] = "`kode_harga` = '" . ($Data['kode_harga']) . "'";
				}
				if( preg_match('/^(status_member|poin|no_anggota|wajib_belanja|potong|tanggal_registrasi)$/i', $key) ) continue; // skip colomn
				$value = trim((string) $value);
				$Columns[] = "`" . $key . "` = " . ((trim((string) $value)!='') ? "'" . escape_string($value) . "'" : "NULL");
			}
			$Sql = "SELECT * from mst_toko where kode_toko = '" . escape_string($Data['kode_toko']) . "' ";
			$Query = $this -> db -> query($Sql);
			if( $Query->num_rows() == 0 ) {
				$id = $this -> db -> next_autoincrement('{prefix}mst_toko');
				$Columns[] = "`id_mst_toko` = '" . escape_string($id) . "'";
				$Columns[] = "`sync_necto` = TRUE ";
				$Sql = "INSERT INTO mst_toko set " . implode(', ', $Columns);
				$Query = $this -> db -> query($Sql);
			} else {
				$_Data = $Query->fetch_array();
				$id = $_Data['id_mst_toko'];
				$Columns[] = "`sync_necto` = TRUE ";
				$Sql = "UPDATE mst_toko set " . implode(', ', $Columns) . " where id_mst_toko = '" . escape_string($id) . "' ";
				$Query = $this -> db -> query($Sql);
			}
			echo "[ok]\n";
		}
		// END TOKO
	}
	function pushToko() {
		// BEGIN TOKO
		$Sql = "SELECT * FROM mst_toko WHERE sync_necto != TRUE OR sync_necto IS NULL";
		$Query = $this -> db -> query($Sql);
		$Datas = $Query -> result_array();

		foreach ($Datas as $Data) {
			echo "\n{$Data['kode_toko']} ";

			$Columns = array();

			foreach ($Data as $key => $value) {
				if ( preg_match('/^[\d]+$/i', $key) ) continue;
				if (trim((string) $value) == '') $value = null;

				// Skip kolom internal MariaDB
				if (preg_match('/^(id_mst_toko|sync_necto)$/i', $key)) continue;

				// Balik mapping: _toko -> _pelanggan
				if (preg_match('/(_toko)$/i', $key)) {
					$key = str_replace('_toko', '_pelanggan', $key);
				}

				// Balik mapping: kode_pelanggan_acc -> akun_piutang
				if (preg_match('/^(kode_pelanggan_acc)$/i', $key)) {
					$key = 'akun_piutang';
				}

				// Balik mapping: kode_harga -> jenis
				if (preg_match('/^(kode_harga)$/i', $key)) {
					$jenis = ((int) $value === 2) ? 'Toko' : 'Reguler';
					$Columns[] = '"jenis" = ' . "'" . escape_string_pgsql($jenis) . "'";
					continue;
				}

				$value = trim((string) $value);
				$Columns[] = '"' . $key . '" = ' . (($value != '') ? "'" . escape_string_pgsql($value) . "'" : "NULL");
			}

			// Cek apakah data sudah ada di PostgreSQL
			$kode_pelanggan = escape_string_pgsql($Data['kode_toko']);
			$Sql = "SELECT kode_pelanggan FROM mst_pelanggan WHERE kode_pelanggan = '{$kode_pelanggan}'";
			$Query = $this -> dbpgMRO -> query($Sql);
			$Datas = $Query -> result_array();

			if (count($Datas) == 0) {
				$Sql = 'INSERT INTO mst_pelanggan SET ' . implode(', ', $Columns);
				$this -> dbpgMRO -> query($Sql);
			} else {
				$Sql = 'UPDATE mst_pelanggan SET ' . implode(', ', $Columns)
					. " WHERE kode_pelanggan = '{$kode_pelanggan}'";
				$this -> dbpgMRO -> query($Sql);
			}

			// Update sync_necto di MariaDB setelah berhasil push
			$id = escape_string($Data['id_mst_toko']);
			$this -> db -> query("UPDATE mst_toko SET sync_necto = TRUE WHERE id_mst_toko = '{$id}'");

			echo "[ok]\n";
		}
		// END TOKO
	}


	function AutoGetLatLngToko() {
		// BEGIN TOKO
		$Sql = "SELECT * from mst_toko where (gps_lat = '' or gps_lat IS NULL) or (gps_lng = '' or gps_lng IS NULL) limit 0,1 ";
		$Query = $this -> db -> query($Sql);
		$Datas = $Query->result_array();
		foreach($Datas as $Data) {
			echo "\n{$Data['kode_toko']} - {$Data['nama_toko']} - {$Data['alamat_toko']} ";

			$alamat = "{$Data['nama_toko']}, {$Data['alamat_toko']}";
			$alamat_encoded = urlencode($alamat);
			$url = "https://maps.googleapis.com/maps/api/geocode/json?address=$alamat_encoded&key=" . config_item('api_key', 'google');
			$response = file_get_contents($url);
			echo $response;
			$data = json_decode($response, true);
			if ($data['status'] === 'OK') {
				$latitude = $data['results'][0]['geometry']['location']['lat'];
				$longitude = $data['results'][0]['geometry']['location']['lng'];
				$Sql = "UPDATE mst_toko set gps_lat = '" . $latitude . "', gps_lng = '" . $longitude . "' where id_mst_toko = '" . escape_string($Data['id_mst_toko']) . "' ";
				echo $this -> db -> query_prefix($Sql).";\n";
				//$Query = $this -> db -> query($Sql);
				echo "Data tersimpan!";
				echo "[ok]\n";
			} else {
				echo "Gagal mendapatkan koordinat.";
			}
		}
		// END TOKO
	}



	function diskonImplemented() {
		$Sql = "UPDATE {prefix}inv_barang set diskon = NULL where diskon >= 1 ";
		$Query = $this -> db -> query($Sql);

		$Sql = "SELECT *
		from {prefix}inv_barang_diskon as bd
		join {prefix}inv_barang_diskon_barang as bdb USING(id_inv_barang_diskon)
		where (now() between diskon_start and diskon_end)
		order by diskon_start asc
		";
		$Query = $this -> db -> query($Sql);
		$Datas = $Query -> result_object();
		foreach($Datas as $Data) {
			$Sql = "UPDATE {prefix}inv_barang set diskon = '".escape_string($Data->diskon)."' where id_inv_barang = '".escape_string($Data->id_inv_barang)."' ";
			$this -> db -> query($Sql);
		}
	}

	function invoice_generate() {
		$this -> load -> libraries('input');

		$this -> load -> libraries('urltopdf');
		echo "#!/bin/bash \n";

		$Sql = "SELECT *
		from {prefix}intimart_buy as b
		where 1=1
		and pdf_file is NULL 
		order by `timestamp`
		";
		$Query = $this -> db -> query($Sql);
		$Datas = $Query -> result_object();
		foreach($Datas as $Data) {
			$id_intimart_buy = $Data->id_intimart_buy;
			$invoice_number = $Data->invoice_number;
			$filename = time();

			$dir = upload_dir('../intimart/invoice/'.($invoice_number));

			$kwitansi_png_exists = file_exists($dir.$filename.'.png');
			if( $kwitansi_png_exists ) delete($dir.$filename.'.png');
			$kwitansi_pdf_exists = file_exists($dir.$filename.'.pdf');
			if( $kwitansi_pdf_exists ) delete($dir.$filename.'.pdf');

			$data['qrcode'] = aehash(_APP_ID_.$invoice_number, 'QR', 24);
			$url     = site_url('intimart/pembelian/invoice/'.$invoice_number.'/'.$data['qrcode']) . '?invoice_generate=true&_=' . $filename;

			$savetopdf = $dir.$filename.'.pdf';
			$this -> urltopdf -> setOption(array(
				'margin-top' => false,
				'margin-right' => false,
				'margin-bottom' => false,
				'margin-left' => false,
				'orientation' => 'Portrait',
				'page-size' => 'A4',
				'page-width' => false,
				'page-height' => false,
				'width' => false,
				'height' => false,
				'zoom' => false,
			));
			$this -> urltopdf -> setCache('/tmp/aefw/wkhtmltopdf/cache');
			$content = $this -> urltopdf -> topdf($url, $savetopdf, true);
			echo "$content \n";

			$savetopng = $dir.$filename.'.png';
			/*
			$this -> urltopdf -> setOption(array(
				'margin-top' => 20,
				'margin-right' => 20,
				'margin-bottom' => false,
				'margin-left' => 20,
				'orientation' => false,
				'page-size' => false,
				'page-width' => false,
				'page-height' => false,
				'width' => false,
				'height' => false,
				'zoom' => false,
			));
			$this -> urltopdf -> setCache('/tmp/aefw/wkhtmltoimage/cache');
			$content = $this -> urltopdf -> tojpg($url, $savetopng, true);
			echo "$content \n";
			/** */
			echo "convert -density 300 -background white -alpha off \"$savetopdf\"[0] \"$savetopng\"\n";

			$savetoe  = $dir.$filename.'e128.pdf';
			echo "convert -density 300 \"$savetopng\" -quality 100 \"$savetoe\" \n";
			$savetoenc = $dir.$filename.'e128821e.pdf';
			echo "qpdf --encrypt \"\" \"".md5($filename)."\" 256 --print=none --modify=none --extract=n -- \"$savetoe\" \"$savetoenc\" \n";

			$Sql = "UPDATE {prefix}intimart_buy set pdf_file = '".escape_string($filename)."' where id_intimart_buy = '".escape_string($id_intimart_buy)."' ";
			$this -> db -> query($Sql);

			echo "\n";
		}
	}



	function invoice_syn_necto() {
		// ── 1. AMBIL ORDER PENDING ────────────────────────────────────────────────
		$Sql = "SELECT
				b.*,
				t.kode_toko,
				t.jenis
			FROM {prefix}intimart_buy b
			LEFT JOIN {prefix}mst_toko t USING(id_mst_toko)
			WHERE b.sync_necto = FALSE
				-- AND b.status > 2 -- 'diproses' belum sync
				AND b.status >= 2 -- 'diproses' langsung sync
			ORDER BY b.timestamp ASC
		";
		$Query = $this -> db -> query($Sql);
		$Datas = $Query -> result_array();
		if (empty($Datas)) return;
		foreach($Datas as $Data) {
			echo "\n{$Data['invoice_number']} - {$Data['nama_penerima']} - {$Data['biaya_total']} - {$Data['status']} \n";
			$id_intimart_buy = (int) $Data['id_intimart_buy'];
			$kodeFaktur = 'JFO' . $Data['invoice_number'];
			try {
				$jenis_faktur  = 'Online';
				// 0: menunggu\n200: selesai\n1: diproses\n2: dikirim
				switch((int) $Data['status']) {
					case -1: // DIBATALKAN
						$status       = ucwords(strtolower('dibatalkan'));
						break;
					case 0: // PENDING
						$status       = ucwords(strtolower('menunggu'));
						break;
					case 1: // DIBAYAR
						$status       = 'Order'; // ucwords(strtolower('diproses'));
						break;
					case 2: // DIPROSES
						$status       = 'Order'; // ucwords(strtolower('diproses'));
						break;
					case 3: // DIKEMAS
						$status       = ucwords(strtolower('dikemas'));
						break;
					case 4: // SIAPKIRIM
						$status       = ucwords(strtolower('siapkirim'));
						break;
					case 5: // DIKIRIM
						$status       = ucwords(strtolower('dikirim'));
						break;
					case 200: // SELESAI
						$status       = ucwords(strtolower('selesai'));
						break;
					default:
						$status       = 'Order';
						break;
				}

				// ── 2. CEK DUPLIKAT DI POSTGRESQL ────────────────────────────────
				$Sql   = "SELECT 1 FROM sls_faktur WHERE kode_faktur = '{$kodeFaktur}' LIMIT 1";
				$Query = $this -> dbpgMRO -> query($Sql);
				$exists = $Query -> result_array();
				if (!empty($exists)) {
					echo "Kode faktur {$kodeFaktur} sudah ada di PostgreSQL, melewati sinkronisasi untuk invoice ini.\n";
					$this -> dbpgMRO -> query("UPDATE sls_faktur
						SET jenis_faktur = '{$jenis_faktur}', status = '{$status}'
						WHERE kode_faktur = '{$kodeFaktur}'
					");
					$this -> db -> query("UPDATE {prefix}intimart_buy SET sync_necto = TRUE WHERE id_intimart_buy = {$id_intimart_buy}");
					continue;
				}

				// ── 3. AMBIL DETAIL ITEMS ─────────────────────────────────────────
				$Sql = "SELECT
						d.qty,
						d.harga,
						d.diskon_item,
						d.log_promo,
						i.kode_barang
					FROM {prefix}intimart_buy_detail d
					LEFT JOIN {prefix}inv_barang i USING(id_inv_barang)
					WHERE d.id_intimart_buy = {$id_intimart_buy}
				";
				$Query = $this -> db -> query($Sql);
				$Details = $Query -> result_array();

				// ── 3b. AMBIL DATA PROMO ──────────────────────────────────────────
				$QueryPromo  = $this->db->query("SELECT kode_promo, diskon_rp FROM {prefix}intimart_buy_promo WHERE id_intimart_buy = {$id_intimart_buy} ORDER BY id_intimart_buy_promo ASC");
				$PromoRows   = $QueryPromo->result_array();
				$promoDiskon = array_sum(array_column($PromoRows, 'diskon_rp'));
				$promoKodes  = array_filter(array_column($PromoRows, 'kode_promo'));
				$kodePromoDiskonStr = implode(',', $promoKodes); // "PR0001" atau "PR0001,PR0002"

				// ── 4. MAPPING FAKTUR ─────────────────────────────────────────────
				$totalBayar  = (float)($Data['bayar_dp'] ?? 0) + (float)($Data['bayar_pelunasan'] ?? 0);
				$totalSistem = (float)($Data['biaya_subtotal'] ?? 0); // (float)($Data['biaya_total'] ?? 0);
				$piutang     = max(0, (float)($Data['biaya_total'] ?? 0) - $totalBayar); // max(0, $totalSistem - $totalBayar);
				$tglFaktur   = $Data['created']
								? date('Y-m-d', strtotime($Data['created']))
								: date('Y-m-d');
				$jamFaktur   = $Data['created']
								? date('H:i:s', strtotime($Data['created']))
								: date('H:i:s');
				$kode_user        = '02';
				$keterangan       = escape_string_pgsql($Data['catatan_utk_penjual'] ?? '');
				$kodePelanggan    = escape_string_pgsql($Data['kode_toko'] ?? '');
				$jenis            = escape_string_pgsql($Data['jenis'] ?? '');
				$promoDiskonPg    = $promoDiskon > 0 ? $promoDiskon : 0; // $promoDiskon > 0 ? $promoDiskon : 'NULL';
				$kodePromoDiskonPg = $kodePromoDiskonStr !== ''
					? "'" . escape_string_pgsql($kodePromoDiskonStr) . "'"
					: 'NULL';

				$Sql = "INSERT INTO sls_faktur (
						kode_faktur, kode_pelanggan, tanggal_faktur, jam, kode_user,
						keterangan, total_sistem, total_bulat,
						bayar, piutang, jenis,
						jenis_faktur, status,
						promo_diskon, kode_promo_diskon
					) VALUES (
						'{$kodeFaktur}', '{$kodePelanggan}', '{$tglFaktur}', '{$jamFaktur}', '{$kode_user}',
						'{$keterangan}', {$totalSistem}, {$totalSistem},
						{$totalBayar}, {$piutang}, '{$jenis}',
						'{$jenis_faktur}', '{$status}',
						{$promoDiskonPg}, {$kodePromoDiskonPg}
					)
				";
				$this -> dbpgMRO -> query($Sql);

				// ── 5. INSERT DETAIL ──────────────────────────────────────────────
				foreach ($Details as $index => $item) {
					$kodeFakturDetail = $kodeFaktur . '.' . $index;
					$kodeBarang       = escape_string_pgsql($item['kode_barang'] ?? '');
					$qty              = (float)($item['qty'] ?? 1);
					$harga            = (float)($item['harga'] ?? 0);
					$hargaJual        = $qty > 0 ? ($harga / $qty) : 0;
					$diskonItem       = (float)($item['diskon_item'] ?? 0);

					// Ekstrak kode_promo dari log_promo (snapshot atau format hadiah)
					$kodePromoItem = '';
					if (!empty($item['log_promo'])) {
						$logArr = json_decode($item['log_promo'], true);
						if (isset($logArr['promo']['kode_promo'])) {
							$kodePromoItem = $logArr['promo']['kode_promo']; // snapshot Tebus Murah
						} elseif (isset($logArr['kode_promo'])) {
							$kodePromoItem = $logArr['kode_promo']; // hadiah Gratis
						}
					}
					$diskonItemPg   = $diskonItem > 0 ? $diskonItem : 0; // $diskonItem > 0 ? $diskonItem : 'NULL';
					$kodePromoItemPg = $kodePromoItem !== ''
						? "'" . escape_string_pgsql($kodePromoItem) . "'"
						: 'NULL';

					$Sql = "INSERT INTO sls_faktur_detail (
							kode_faktur_detail, kode_faktur,
							kode_barang, jumlah, harga_jual,
							diskon, kode_promo
						) VALUES (
							'{$kodeFakturDetail}', '{$kodeFaktur}',
							'{$kodeBarang}', {$qty}, {$hargaJual},
							{$diskonItemPg}, {$kodePromoItemPg}
						)
					";
					$this -> dbpgMRO -> query($Sql);
				}

				// ── 6. TANDAI SYNCED DI MARIADB ───────────────────────────────────
				$this -> db -> query("UPDATE {prefix}intimart_buy SET sync_necto = TRUE WHERE id_intimart_buy = {$id_intimart_buy}");

			} catch (Exception $e) {
				// Gagal 1 invoice → skip, lanjut invoice berikutnya
				echo "syncNectoPostgres FAIL [{$kodeFaktur}]: " . $e->getMessage();
				continue;
			}
		}
	}

}
